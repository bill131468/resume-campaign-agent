# Non-secret variable names only. Use the llm-api-config skill to create .env.local.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://example.invalid/v1
LLM_MODEL=your-model-name
LLM_API_KEY=

# Production is the fail-closed default. Test fixtures must be opted in locally.
APP_ENV=production
ENABLE_TEST_FIXTURES=false
